# Application Configuration
APP_NAME=text-to-sql-agent
DEBUG=true

# Auth & Encryption Configuration
SECRET_KEY=change-this-jwt-secret-in-production
ENCRYPTION_KEY=0G2t7L4D3tM-0fN7V8zL9kP1mQ2wE4rT6yU8iO0pA1s=
AUTH_DB_PATH=vector_cache/auth.db

# Database Configuration
# Main Admin/App Database URL (asyncpg format for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/text_to_sql_db

# Read-only Database URL (restricted role for executing generated SQL safely)
READONLY_DATABASE_URL=postgresql+asyncpg://sql_readonly:readonly_password@localhost:5432/text_to_sql_db

# Explicit SQL Dialect setting (default: postgres)
SQL_DIALECT=postgres

# Opt-in write permissions for default application database (default: false)
ALLOW_DEFAULT_DB_WRITES=false

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Multi-LLM Provider Router Configuration
# Comma-separated priority fallback order (e.g. anthropic,openai,groq,gemini)
LLM_PROVIDER_ORDER=anthropic,openai,groq,gemini
LLM_TEMPERATURE=0.0

# Agent self-correction retry budget (controls max reflection iterations per question, distinct from LLM SDK internal retries)
MAX_RETRIES=3

# Provider API Keys (only providers with configured keys will be queried)
# Note: Check provider model identifiers periodically as provider availability and versions evolve
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# Embedding Backend ("keyword" for local sparse token vectors or "openai" for text-embedding-3-small)
EMBEDDING_BACKEND=keyword
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

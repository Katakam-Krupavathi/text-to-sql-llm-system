# Application Configuration
APP_NAME=text-to-sql-agent
DEBUG=true

# Database Configuration
# Main Admin/App Database URL (asyncpg format for async SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/text_to_sql_db

# Read-only Database URL (restricted role for executing generated SQL safely)
READONLY_DATABASE_URL=postgresql+asyncpg://sql_readonly:readonly_password@localhost:5432/text_to_sql_db

# Explicit SQL Dialect setting (default: postgres)
SQL_DIALECT=postgres

# Database Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# LLM Provider Configuration ("openai" or "anthropic")
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_TEMPERATURE=0.0
# Agent self-correction retry budget (controls max reflection iterations per question, distinct from LLM SDK internal retries)
MAX_RETRIES=3

# Embedding Backend ("keyword" for local sparse token vectors or "openai" for text-embedding-3-small)
EMBEDDING_BACKEND=keyword
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

